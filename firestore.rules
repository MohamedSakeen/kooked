rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The app scopes all per-user data under households/{uid}
    // (pantry, shoppingList, stats, cookingHistory). It also supports
    // real households created through createHousehold()/joinHousehold()
    // via a memberIds array.
    function isHouseholdMember(householdId) {
      return request.auth.uid == householdId ||
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId))
            .data.get('memberIds', []);
    }

    // Each user may only access their own profile document.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Household document itself.
    match /households/{householdId} {
      allow read: if isSignedIn() && isHouseholdMember(householdId);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.get('memberIds', []);
      allow update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.get('memberIds', []);
    }

    // Household subcollections: pantry, shoppingList, stats, cookingHistory.
    match /households/{householdId}/{document=**} {
      allow read, write: if isSignedIn() && isHouseholdMember(householdId);
    }

    // Recipes are shared and read-only for the app; they are seeded and
    // updated by the backend using the Admin SDK, which bypasses rules.
    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
